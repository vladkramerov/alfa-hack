{
  "hypothesis": "HYP-085",
  "strategy": "conditional_lognormal_mean",
  "version": 1,
  "family": "catboost",
  "parameters": {
    "iterations": 800,
    "depth": 6,
    "learning_rate": 0.05,
    "l2_leaf_reg": 10.0,
    "loss_function": "RMSEWithUncertainty",
    "random_seed": 42,
    "thread_count": 2,
    "verbose": false,
    "allow_writing_files": false
  },
  "feature_numbers": [
    29,
    30,
    31
  ],
  "target_transform": "log1p",
  "loss": "Gaussian_negative_log_likelihood_on_log1p_y",
  "raw_parameters": [
    "conditional_log_mean_mu",
    "conditional_log_standard_deviation"
  ],
  "prediction": "expm1(mu+0.5*min(exp(2*log_sigma),2))",
  "variance_cap": 2.0,
  "numerical_log_sigma_floor": -350.0,
  "numerical_log_mean_bounds": [
    0.0,
    700.0
  ],
  "preprocessing": "fit_only_feature_composition_numeric_inf_to_nan_native_tagged_categories",
  "class_or_global_smearing_factor": false,
  "base_used": false,
  "query_statistics": false,
  "row_deletion": false,
  "selection": "fixed_all_rounds_no_validation_earlystop"
}